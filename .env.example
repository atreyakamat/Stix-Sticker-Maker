# Copy to .env and adjust as needed. docker-compose and the backend both read
# these (the backend reads them from its own process environment).

# --- Backend / model ---------------------------------------------------------
# Compute device: auto | cpu | cuda | dml
#   auto  picks CUDA if available, else CPU (DirectML only if you set it)
#   dml   uses an AMD/Intel GPU on native Windows (needs: pip install torch-directml)
# Inside the Docker Linux container this must be cpu or cuda.
STIX_DEVICE=auto

# Model loaded at startup and used as the fallback. See model_loader.MODEL_REGISTRY.
# Options: birefnet, birefnet_lite, birefnet_hr, birefnet_matting,
#          birefnet_hr_matting, birefnet_portrait, rmbg14
STIX_MODEL=birefnet

# Default quality tier when the UI/API doesn't specify one: fast | balanced | quality
STIX_DEFAULT_TIER=balanced

# Default inference resolution for the startup model (tiers override this).
STIX_MODEL_RES=1024

# How many distinct models to keep resident in RAM simultaneously.
STIX_MODEL_CACHE=2

# --- Frontend (build-time) ---------------------------------------------------
# Leave empty for the Docker setup (same-origin, nginx-proxied).
# For a split deploy, set to the backend origin, e.g. https://api.example.com
VITE_API_BASE=
